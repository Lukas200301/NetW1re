<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Design.PreviewWith>
    <Border Padding="24" Background="#0B0E14">
      <StackPanel Spacing="12" Width="280">
        <TextBlock Classes="h1" Text="Heading 1"/>
        <TextBlock Classes="h2" Text="Heading 2"/>
        <TextBlock Classes="p" Text="Body paragraph text for preview."/>
        <TextBox Watermark="Text box"/>
        <ComboBox SelectedIndex="0" HorizontalAlignment="Stretch">
          <ComboBoxItem>Item one</ComboBoxItem>
          <ComboBoxItem>Item two</ComboBoxItem>
        </ComboBox>
        <CheckBox Content="Check box"/>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="Primary" Classes="accent"/>
          <Button Content="Secondary"/>
        </StackPanel>
      </StackPanel>
    </Border>
  </Design.PreviewWith>

  <!-- ============================================================
       NetW1re — flat, modern dark control theme.
       Colors come from App.axaml ({StaticResource Nw.*}).
       ============================================================ -->

  <!-- Window -->
  <Style Selector="Window">
    <Setter Property="SizeToContent" Value="Height" />
    <Setter Property="WindowStartupLocation" Value="CenterOwner" />
    <Setter Property="TransparencyLevelHint" Value="None" />
    <Setter Property="Background" Value="{StaticResource Nw.Brush.Background}" />
    <Setter Property="ExtendClientAreaToDecorationsHint" Value="True" />
    <Setter Property="Icon" Value="/Assets/netw1re-logo.ico" />
    <Setter Property="FontFamily" Value="/Assets/Fonts/Montserrat.ttf#Montserrat" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Foreground" Value="{StaticResource Nw.Brush.TextPrimary}" />
  </Style>

  <!-- ===================== Typography ===================== -->
  <Style Selector="TextBlock.title">
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="FontSize" Value="26"/>
    <Setter Property="Foreground" Value="{StaticResource Nw.Brush.TextPrimary}"/>
    <Setter Property="Margin" Value="0,12,0,12"/>
  </Style>

  <Style Selector="TextBlock.h1">
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="FontSize" Value="20"/>
    <Setter Property="Foreground" Value="{StaticResource Nw.Brush.TextPrimary}"/>
    <Setter Property="Margin" Value="0,0,0,12"/>
  </Style>

  <Style Selector="TextBlock.h2">
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="FontSize" Value="16"/>
    <Setter Property="Foreground" Value="{StaticResource Nw.Brush.TextPrimary}"/>
    <Setter Property="Margin" Value="0,0,0,10"/>
  </Style>

  <Style Selector="TextBlock.h3">
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Foreground" Value="{StaticResource Nw.Brush.TextSecondary}"/>
    <Setter Property="Margin" Value="0,0,0,6"/>
  </Style>

  <Style Selector="TextBlock.p">
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Foreground" Value="{StaticResource Nw.Brush.TextSecondary}"/>
    <Setter Property="LineHeight" Value="20"/>
    <Setter Property="Margin" Value="0,0,0,6"/>
  </Style>

  <Style Selector="TextBlock.small">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Foreground" Value="{StaticResource Nw.Brush.TextMuted}"/>
  </Style>

  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Foreground" Value="{StaticResource Nw.Brush.TextMuted}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="LetterSpacing" Value="0.8"/>
  </Style>

  <!-- ===================== Containers ===================== -->
  <!-- Card / panel surface -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{StaticResource Nw.Brush.Surface}" />
    <Setter Property="BorderBrush" Value="{StaticResource Nw.Brush.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="20" />
  </Style>

  <!-- Legacy container classes, flattened -->
  <Style Selector="Border.control-group">
    <Setter Property="Background" Value="{StaticResource Nw.Brush.Surface}" />
    <Setter Property="BorderBrush" Value="{StaticResource Nw.Brush.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="20" />
  </Style>

  <Style Selector="Border.label">
    <Setter Property="Background" Value="{StaticResource Nw.Brush.SurfaceElevated}" />
    <Setter Property="BorderBrush" Value="{StaticResource Nw.Brush.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="16,12" />
  </Style>

  <Style Selector="Border.label > StackPanel > TextBlock">
    <Setter Property="Foreground" Value="{StaticResource Nw.Brush.TextPrimary}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="14" />
  </Style>

  <Style Selector="Border.wrapper">
    <Setter Property="Padding" Value="16" />
  </Style>

  <!-- ===================== Buttons ===================== -->
  <!-- Default: secondary / subtle -->
  <Style Selector="Button">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{StaticResource Nw.Brush.TextPrimary}" />
    <Setter Property="Background" Value="{StaticResource Nw.Brush.SurfaceElevated}" />
    <Setter Property="BorderBrush" Value="{StaticResource Nw.Brush.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="16,9" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.15"/>
        <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Button /template/ ContentPresenter">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.15"/>
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Nw.Brush.SurfaceHover}" />
    <Setter Property="BorderBrush" Value="{StaticResource Nw.Brush.BorderStrong}" />
  </Style>

  <Style Selector="Button:pressed">
    <Setter Property="RenderTransform" Value="scale(0.98)" />
  </Style>

  <Style Selector="Button:disabled">
    <Setter Property="Opacity" Value="0.45" />
  </Style>

  <!-- Accent / primary button -->
  <Style Selector="Button.accent">
    <Setter Property="Background" Value="{StaticResource Nw.Brush.Accent}" />
    <Setter Property="BorderBrush" Value="{StaticResource Nw.Brush.Accent}" />
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>
  <Style Selector="Button.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Nw.Brush.AccentLight}" />
    <Setter Property="BorderBrush" Value="{StaticResource Nw.Brush.AccentLight}" />
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>

  <!-- Danger button -->
  <Style Selector="Button.danger">
    <Setter Property="Background" Value="{StaticResource Nw.Brush.Error}" />
    <Setter Property="BorderBrush" Value="{StaticResource Nw.Brush.Error}" />
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>
  <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#FF6B63" />
    <Setter Property="BorderBrush" Value="#FF6B63" />
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>

  <!-- Ghost / text button -->
  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Nw.Brush.SurfaceHover}" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>

  <!-- ===================== TextBox ===================== -->
  <Style Selector="TextBox">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{StaticResource Nw.Brush.TextPrimary}" />
    <Setter Property="Background" Value="{StaticResource Nw.Brush.SurfaceElevated}" />
    <Setter Property="BorderBrush" Value="{StaticResource Nw.Brush.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="12,9" />
    <Setter Property="SelectionBrush" Value="{StaticResource Nw.Brush.AccentDark}" />
    <Setter Property="CaretBrush" Value="{StaticResource Nw.Brush.Accent}" />
    <Setter Property="MinHeight" Value="38" />
  </Style>
  <Style Selector="TextBox /template/ Border#PART_BorderElement">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="{StaticResource Nw.Brush.BorderStrong}" />
  </Style>
  <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="{StaticResource Nw.Brush.Accent}" />
  </Style>
  <Style Selector="TextBox:focus">
    <Setter Property="Background" Value="{StaticResource Nw.Brush.SurfaceElevated}" />
  </Style>

  <!-- ===================== ComboBox ===================== -->
  <Style Selector="ComboBox">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{StaticResource Nw.Brush.TextPrimary}" />
    <Setter Property="Background" Value="{StaticResource Nw.Brush.SurfaceElevated}" />
    <Setter Property="BorderBrush" Value="{StaticResource Nw.Brush.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="MinHeight" Value="38" />
  </Style>
  <Style Selector="ComboBox /template/ Border#Background">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="ComboBox:pointerover /template/ Border#Background">
    <Setter Property="BorderBrush" Value="{StaticResource Nw.Brush.BorderStrong}" />
    <Setter Property="Background" Value="{StaticResource Nw.Brush.SurfaceHover}" />
  </Style>
  <Style Selector="ComboBox:focus /template/ Border#Background">
    <Setter Property="BorderBrush" Value="{StaticResource Nw.Brush.Accent}" />
  </Style>
  <Style Selector="ComboBoxItem">
    <Setter Property="Foreground" Value="{StaticResource Nw.Brush.TextPrimary}" />
    <Setter Property="Padding" Value="12,9" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="ComboBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Nw.Brush.AccentSubtle}" />
  </Style>
  <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Nw.Brush.SurfaceHover}" />
  </Style>

  <!-- ===================== CheckBox ===================== -->
  <Style Selector="CheckBox">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{StaticResource Nw.Brush.TextPrimary}" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>
  <Style Selector="CheckBox /template/ Border#NormalRectangle">
    <Setter Property="Background" Value="{StaticResource Nw.Brush.SurfaceElevated}" />
    <Setter Property="BorderBrush" Value="{StaticResource Nw.Brush.BorderStrong}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="5" />
  </Style>
  <Style Selector="CheckBox:checked /template/ Border#NormalRectangle">
    <Setter Property="Background" Value="{StaticResource Nw.Brush.Accent}" />
    <Setter Property="BorderBrush" Value="{StaticResource Nw.Brush.Accent}" />
  </Style>
  <Style Selector="CheckBox:pointerover /template/ Border#NormalRectangle">
    <Setter Property="BorderBrush" Value="{StaticResource Nw.Brush.Accent}" />
  </Style>

  <!-- ===================== RadioButton ===================== -->
  <Style Selector="RadioButton">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{StaticResource Nw.Brush.TextPrimary}" />
  </Style>
  <Style Selector="RadioButton /template/ Ellipse#OuterEllipse">
    <Setter Property="Fill" Value="{StaticResource Nw.Brush.SurfaceElevated}" />
    <Setter Property="Stroke" Value="{StaticResource Nw.Brush.BorderStrong}" />
    <Setter Property="StrokeThickness" Value="1" />
  </Style>
  <Style Selector="RadioButton:checked /template/ Ellipse#OuterEllipse">
    <Setter Property="Stroke" Value="{StaticResource Nw.Brush.Accent}" />
  </Style>
  <Style Selector="RadioButton:checked /template/ Ellipse#CheckOuterEllipse">
    <Setter Property="Fill" Value="{StaticResource Nw.Brush.Accent}" />
    <Setter Property="Stroke" Value="{StaticResource Nw.Brush.Accent}" />
  </Style>
  <Style Selector="RadioButton:checked /template/ Ellipse#CheckGlyph">
    <Setter Property="Fill" Value="#FFFFFF" />
  </Style>

  <!-- ===================== Info panel (key/value rows) ===================== -->
  <Style Selector="StackPanel.infoPanel">
    <Setter Property="Orientation" Value="Horizontal"/>
    <Setter Property="Margin" Value="0,0,0,8"/>
  </Style>
  <Style Selector="StackPanel.infoPanel > TextBlock.label">
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Foreground" Value="{StaticResource Nw.Brush.TextPrimary}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="StackPanel.infoPanel > Rectangle.indicator">
    <Setter Property="Margin" Value="0,0,12,0"/>
  </Style>
  <Style Selector="StackPanel.infoPanel > TextBlock.labelValue">
    <Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Foreground" Value="{StaticResource Nw.Brush.TextSecondary}"/>
    <Setter Property="Margin" Value="12,0,0,0"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <!-- ===================== DataGrid ===================== -->
  <Style Selector="DataGrid">
    <Setter Property="Background" Value="{StaticResource Nw.Brush.Surface}" />
    <Setter Property="Foreground" Value="{StaticResource Nw.Brush.TextPrimary}" />
    <Setter Property="BorderBrush" Value="{StaticResource Nw.Brush.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="RowBackground" Value="Transparent" />
    <Setter Property="GridLinesVisibility" Value="Horizontal" />
    <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource Nw.Brush.Border}" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="DataGridRow">
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="Foreground" Value="{StaticResource Nw.Brush.TextSecondary}" />
  </Style>
  <Style Selector="DataGridRow:pointerover /template/ Rectangle#BackgroundRectangle">
    <Setter Property="Fill" Value="{StaticResource Nw.Brush.SurfaceHover}" />
  </Style>
  <Style Selector="DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
    <Setter Property="Fill" Value="{StaticResource Nw.Brush.AccentSubtle}" />
  </Style>
  <Style Selector="DataGridRow:selected">
    <Setter Property="Foreground" Value="{StaticResource Nw.Brush.TextPrimary}" />
  </Style>
  <Style Selector="DataGridColumnHeader">
    <Setter Property="Background" Value="{StaticResource Nw.Brush.Chrome}" />
    <Setter Property="Foreground" Value="{StaticResource Nw.Brush.TextMuted}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Padding" Value="14,10" />
    <Setter Property="SeparatorBrush" Value="{StaticResource Nw.Brush.Border}" />
    <Setter Property="MinHeight" Value="42" />
  </Style>
  <Style Selector="DataGridCell">
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="DataGridCell:focus /template/ Rectangle#FocusVisual">
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <!-- ===================== ToolTip ===================== -->
  <Style Selector="ToolTip">
    <Setter Property="Background" Value="{StaticResource Nw.Brush.SurfaceElevated}"/>
    <Setter Property="Foreground" Value="{StaticResource Nw.Brush.TextPrimary}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Padding" Value="12,8"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="BorderBrush" Value="{StaticResource Nw.Brush.Border}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="MaxWidth" Value="320"/>
  </Style>

  <!-- ===================== ScrollBar ===================== -->
  <Style Selector="ScrollBar">
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <Style Selector="ScrollBar:vertical">
    <Setter Property="Width" Value="10"/>
  </Style>
  <Style Selector="ScrollBar:horizontal">
    <Setter Property="Height" Value="10"/>
  </Style>
  <Style Selector="ScrollBar /template/ Thumb">
    <Setter Property="Background" Value="{StaticResource Nw.Brush.BorderStrong}"/>
    <Setter Property="CornerRadius" Value="5"/>
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.15"/>
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="ScrollBar /template/ Thumb:pointerover">
    <Setter Property="Background" Value="{StaticResource Nw.Brush.TextMuted}"/>
  </Style>

  <!-- ===================== Menu / ContextMenu ===================== -->
  <Style Selector="MenuItem">
    <Setter Property="Foreground" Value="{StaticResource Nw.Brush.TextPrimary}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Padding" Value="12,8"/>
    <Setter Property="CornerRadius" Value="6"/>
  </Style>
  <Style Selector="MenuItem:pointerover /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{StaticResource Nw.Brush.SurfaceHover}"/>
  </Style>
  <Style Selector="ContextMenu">
    <Setter Property="Background" Value="{StaticResource Nw.Brush.SurfaceElevated}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Nw.Brush.Border}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="Padding" Value="6"/>
  </Style>
  <Style Selector="Menu">
    <Setter Property="Background" Value="Transparent"/>
  </Style>

  <!-- ===================== Popup / flyout surfaces ===================== -->
  <Style Selector="ComboBox /template/ Popup Border#PopupBorder">
    <Setter Property="Background" Value="{StaticResource Nw.Brush.SurfaceElevated}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Nw.Brush.Border}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="10"/>
  </Style>

  <!-- ===================== Focus visuals ===================== -->
  <Style Selector="Button:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{StaticResource Nw.Brush.Accent}"/>
  </Style>

</Styles>
