<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:cmpts="using:NetW1reAvalonia.Core.Views.Components"
		xmlns:convos="using:NetW1reAvalonia.Core.Converters">
	<Design.PreviewWith>
		<Border Background="#10141D" Padding="16">
			<StackPanel Orientation="Horizontal" Spacing="4">
				<cmpts:NavButton Text="Devices" />
				<cmpts:NavButton Text="Rules" IsActive="True" />
				<cmpts:NavButton Text="Sniffer" />
			</StackPanel>
		</Border>
	</Design.PreviewWith>

	<!-- Template: compact icon-over-label pill -->
	<Style Selector="cmpts|NavButton">
		<Setter Property="Template">
			<ControlTemplate>
				<Button
					Background="Transparent"
					BorderBrush="Transparent"
					BorderThickness="1"
					CornerRadius="10"
					Command="{TemplateBinding Command}"
					CommandParameter="{TemplateBinding CommandParameter}"
					MinWidth="104"
					Height="56"
					Margin="2,0"
					Padding="12,6"
					Cursor="Hand"
					HorizontalAlignment="Stretch"
					VerticalAlignment="Stretch"
					HorizontalContentAlignment="Center"
					VerticalContentAlignment="Center"
					ToolTip.Placement="Bottom">
					<StackPanel Orientation="Vertical" Spacing="5" VerticalAlignment="Center">
						<Image
						   Source="{TemplateBinding Icon, Converter={x:Static convos:ImageConverters.FromPath}}"
						   Width="20"
						   Height="20"
						   HorizontalAlignment="Center"/>
						<TextBlock
						   Text="{TemplateBinding Text}"
						   FontSize="11"
						   FontWeight="Medium"
						   HorizontalAlignment="Center"
						   TextWrapping="NoWrap"/>
					</StackPanel>
				</Button>
			</ControlTemplate>
		</Setter>
	</Style>

	<!-- Default button chrome inside the nav button -->
	<Style Selector="cmpts|NavButton Button">
		<Setter Property="Transitions">
			<Transitions>
				<BrushTransition Property="Background" Duration="0:0:0.15"/>
			</Transitions>
		</Setter>
	</Style>

	<!-- Hover -->
	<Style Selector="cmpts|NavButton Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
		<Setter Property="Background" Value="#222838"/>
		<Setter Property="BorderBrush" Value="Transparent"/>
	</Style>

	<!-- Active -->
	<Style Selector="cmpts|NavButton[IsActive=true] Button /template/ ContentPresenter#PART_ContentPresenter">
		<Setter Property="Background" Value="#15233A"/>
		<Setter Property="BorderBrush" Value="#2F88EB"/>
	</Style>
	<Style Selector="cmpts|NavButton[IsActive=true] Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
		<Setter Property="Background" Value="#1A2B45"/>
		<Setter Property="BorderBrush" Value="#2F88EB"/>
	</Style>

	<!-- Text color states -->
	<Style Selector="cmpts|NavButton TextBlock">
		<Setter Property="Foreground" Value="#9FB0C3"/>
		<Setter Property="Transitions">
			<Transitions>
				<BrushTransition Property="Foreground" Duration="0:0:0.15"/>
			</Transitions>
		</Setter>
	</Style>
	<Style Selector="cmpts|NavButton:pointerover TextBlock">
		<Setter Property="Foreground" Value="#E6EDF3"/>
	</Style>
	<Style Selector="cmpts|NavButton[IsActive=true] TextBlock">
		<Setter Property="Foreground" Value="#8FC2F7"/>
		<Setter Property="FontWeight" Value="SemiBold"/>
	</Style>

	<!-- Icon opacity states -->
	<Style Selector="cmpts|NavButton Image">
		<Setter Property="Opacity" Value="0.7"/>
		<Setter Property="Transitions">
			<Transitions>
				<DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
			</Transitions>
		</Setter>
	</Style>
	<Style Selector="cmpts|NavButton:pointerover Image">
		<Setter Property="Opacity" Value="1.0"/>
	</Style>
	<Style Selector="cmpts|NavButton[IsActive=true] Image">
		<Setter Property="Opacity" Value="1.0"/>
	</Style>
</Styles>
