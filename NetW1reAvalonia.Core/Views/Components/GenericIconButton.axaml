<Styles xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:cmpts="using:NetW1reAvalonia.Core.Views.Components"
		xmlns:convos="using:NetW1reAvalonia.Core.Converters">
	<Design.PreviewWith>
		<cmpts:GenericIconButton   Name="Scan"
					   Icon="Assets/NavIcons/scan.png"
					   Text="Scan"
					   Background="{Binding Theme.NavElementBackground}">
		</cmpts:GenericIconButton>
	</Design.PreviewWith>
	<Style Selector="cmpts|GenericIconButton">
		<Setter Property="Template">
			<ControlTemplate>
				<Button CornerRadius="8"
						Background="#1A1F2B"
						BorderBrush="#232A38"
						BorderThickness="1"
						Foreground="#E6EDF3"
						Cursor="Hand"
						Command="{TemplateBinding Command}"
						CommandParameter="{TemplateBinding CommandParameter}"
						HorizontalAlignment="Stretch"
						Padding="16,10">
					<Button.Styles>
						<Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
							<Setter Property="Background" Value="#2F88EB"/>
							<Setter Property="BorderBrush" Value="#2F88EB"/>
						</Style>
						<Style Selector="Button:pressed">
							<Setter Property="RenderTransform" Value="scale(0.98)"/>
						</Style>
						<Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
							<Setter Property="Background" Value="#1F6FD0"/>
							<Setter Property="BorderBrush" Value="#1F6FD0"/>
						</Style>
					</Button.Styles>
					<StackPanel Orientation="Horizontal"
								HorizontalAlignment="Center"
								VerticalAlignment="Center"
								Spacing="10">
						<Image Classes="icon"
							   Width="18"
							   Height="18"
							   VerticalAlignment="Center"
							   Source="{TemplateBinding Icon, Converter={x:Static convos:ImageConverters.FromPath}}"/>
						<TextBlock Classes="text"
								   VerticalAlignment="Center"
								   Text="{TemplateBinding Text}"
								   Foreground="#FFFFFF"
								   FontWeight="SemiBold"
								   FontSize="13"/>
					</StackPanel>
				</Button>
			</ControlTemplate>
		</Setter>
	</Style>
</Styles>



