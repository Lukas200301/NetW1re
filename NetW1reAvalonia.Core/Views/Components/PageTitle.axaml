<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="NetW1reAvalonia.Core.Views.Components.PageTitle">    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                Spacing="14"
                Margin="0,28,0,20">
        <Border Width="4" Height="26"
                CornerRadius="2"
                Background="{StaticResource Nw.Brush.Accent}"
                VerticalAlignment="Center" />
        <TextBlock Name="PageTitleText"
                   Text="{Binding $parent[UserControl].Text}"
                   Foreground="{StaticResource Nw.Brush.TextPrimary}"
                   FontSize="24"
                   FontWeight="Bold"
                   VerticalAlignment="Center" />
    </StackPanel>
</UserControl>



