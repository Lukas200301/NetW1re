<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:viewModels="clr-namespace:NetW1reAvalonia.Core.ViewModels.RoutedViewModels"
			 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 x:Class="NetW1reAvalonia.Core.Views.Components.StatsBox">

	<Design.DataContext>
		<viewModels:HomeViewModel />
	</Design.DataContext>	<StackPanel Orientation="Horizontal" Spacing="16">
		<Border CornerRadius="10"
				Padding="18,10"
				Background="{StaticResource Nw.Brush.Surface}"
				BorderBrush="{StaticResource Nw.Brush.Border}"
				BorderThickness="1">
			<StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="10"
						ToolTip.Tip="Number of active devices">
				<Ellipse Width="8" Height="8" Fill="{StaticResource Nw.Brush.Success}"/>
				<TextBlock Text="Devices"
						   Foreground="{StaticResource Nw.Brush.TextSecondary}"
						   FontSize="13"
						   FontWeight="Medium"
						   VerticalAlignment="Center"/>
				<TextBlock Text="{Binding Devices.Count}"
						   Foreground="{StaticResource Nw.Brush.TextPrimary}"
						   FontSize="16"
						   FontWeight="Bold"
						   VerticalAlignment="Center"/>
			</StackPanel>
		</Border>
	</StackPanel>
</UserControl>



